# ─────────────────────────────────────────────────────────────────────────────
# Inheritix — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site base URL used for canonical URLs, hreflang, Open Graph, and sitemap.
# Default: https://inheritixai.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://inheritixai.com

# PostgreSQL connection string for Payload CMS.
# Local development example with docker-compose:
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/inheritix

# Secret used by Payload CMS to sign authentication tokens and sessions.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret-for-payload

# Secret used to validate authenticated draft preview requests.
# Generate with: openssl rand -base64 32
PREVIEW_SECRET=replace-with-a-long-random-secret-for-preview

# Media upload storage path (optional, defaults to ./public/media in local dev)
# For production cloud storage (e.g. S3 / R2), configure storage adapter
# MEDIA_STORAGE_DIR=public/media

# Optional analytics & notification integrations (Milestone Three)
# NEXT_PUBLIC_GA_ID=
# RESEND_API_KEY=
# CONTACT_REPLY_TO=hello@inheritix.com
