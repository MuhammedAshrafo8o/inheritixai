# ─────────────────────────────────────────────────────────────────────────────
# Inheritix — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing secrets.
#
# Validation (src/env.ts) runs inside the Payload config, so the website, the
# admin, the REST/GraphQL API and every CLI command (migrate, seed,
# bootstrap:users) refuse to start with missing or placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site origin for canonical URLs, hreflang, Open Graph, sitemap and
# Payload's serverURL. Required in production. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:8443

# PostgreSQL connection string (required). Use a dedicated database per environment.
DATABASE_URI=postgresql://inheritix:CHANGE_ME@127.0.0.1:5432/inheritix

# Signs CMS sessions. Required; at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=

# Bearer secret for /api/cache/projects (manual cache invalidation).
# Required in production; at least 32 random characters.
PREVIEW_SECRET=

# ── Account bootstrap (npm run bootstrap:users) ─────────────────────────────
# Optional. When unset, the command prompts interactively (hidden input).
# There are no default passwords. Minimum 14 characters, 3 character classes.
# INHERITIX_ADMIN_EMAIL=
# INHERITIX_ADMIN_NAME=
# INHERITIX_ADMIN_PASSWORD=
# INHERITIX_EDITOR_EMAIL=
# INHERITIX_EDITOR_NAME=
# INHERITIX_EDITOR_PASSWORD=

# ── Development only ────────────────────────────────────────────────────────
# Show illustrative project fixtures when the database has no published
# projects. Rejected in production. Off unless explicitly "true".
# INHERITIX_DEV_FIXTURES=true

# Optional integrations (Milestone Three)
# NEXT_PUBLIC_GA_ID=
# RESEND_API_KEY=
# CONTACT_REPLY_TO=hello@inheritix.com
