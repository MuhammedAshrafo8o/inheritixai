# ─────────────────────────────────────────────────────────────────────────────
# Inheritix — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL used for canonical URLs, OG tags, and the sitemap.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://inheritix.com

# PostgreSQL connection string for Payload CMS.
# Local dev example: postgresql://postgres:password@localhost:5432/inheritix
DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secret used by Payload CMS to sign tokens. Must be long and random.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Secret used to validate draft-preview requests.
# Must match the value configured in payload/collections/Projects.ts admin.preview.
# Generate with: openssl rand -base64 32
PREVIEW_SECRET=replace-with-a-long-random-secret

# (Optional) Google Analytics measurement ID, e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=

# (Optional) Resend API key for contact-form email forwarding.
# RESEND_API_KEY=

# (Optional) Reply-to address for forwarded contact submissions.
# CONTACT_REPLY_TO=hello@inheritix.com
